<%- include('partials/head') %>

<div style="display:grid;grid-template-columns:minmax(0,1fr) 340px;gap:18px;align-items:start;">
  <div class="card">
    <div class="card-head"><h3>友情链接（<%= list.length %>）</h3></div>
    <div class="table-wrap">
      <table class="data">
        <thead><tr><th>名称</th><th>链接</th><th>排序</th><th>状态</th><th>操作</th></tr></thead>
        <tbody>
          <% if (!list.length) { %><tr><td colspan="5" class="empty">暂无友链</td></tr><% } %>
          <% list.forEach(function (l) { %>
            <tr>
              <td><b><%= l.name %></b></td>
              <td><a href="<%= l.url %>" target="_blank" rel="noopener" class="small"><%= l.url %></a></td>
              <td class="muted"><%= l.sort ?? 100 %></td>
              <td>
                <% if (l.active !== false) { %><span class="badge b-green">正常</span>
                <% } else { %><span class="badge b-gray">隐藏</span><% } %>
              </td>
              <td class="actions">
                <button class="btn btn-outline btn-sm" type="button"
                  onclick='fillLink(<%- JSON.stringify({ id: l.id, name: l.name, url: l.url, sort: l.sort, active: l.active !== false }).replace(/'/g, "&#39;") %>)'>编辑</button>
                <form method="post" action="/admin/links/<%= l.id %>/delete" style="display:inline;" data-confirm="确定删除友链「<%= l.name %>」吗？">
                  <input type="hidden" name="_csrf" value="<%= csrf %>">
                  <button class="btn btn-danger btn-sm" type="submit">删除</button>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="card">
    <div class="card-head"><h3 id="linkTitle">新增友链</h3></div>
    <div class="card-body">
      <form method="post" action="/admin/links/save" id="linkForm">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <input type="hidden" name="id" id="lId" value="">
        <div class="form-group">
          <label>网站名称 <span style="color:var(--danger);">*</span></label>
          <input class="form-control" type="text" name="name" id="lName" required>
        </div>
        <div class="form-group">
          <label>网站地址 <span style="color:var(--danger);">*</span></label>
          <input class="form-control" type="text" name="url" id="lUrl" placeholder="https://" required>
        </div>
        <div class="form-group">
          <label>排序</label>
          <input class="form-control" type="number" name="sort" id="lSort" value="100">
        </div>
        <label class="checkbox"><input type="checkbox" name="active" id="lActive" checked> 前台显示</label>
        <div class="divider"></div>
        <button class="btn btn-primary btn-block" type="submit">保存友链</button>
        <button class="btn btn-outline btn-block" type="button" style="margin-top:8px;" onclick="resetLink()">清空表单</button>
      </form>
    </div>
  </div>
</div>

<script>
function fillLink(l) {
  document.getElementById('lId').value = l.id;
  document.getElementById('lName').value = l.name;
  document.getElementById('lUrl').value = l.url;
  document.getElementById('lSort').value = l.sort ?? 100;
  document.getElementById('lActive').checked = l.active;
  document.getElementById('linkTitle').textContent = '编辑友链';
}
function resetLink() {
  document.getElementById('linkForm').reset();
  document.getElementById('lId').value = '';
  document.getElementById('lActive').checked = true;
  document.getElementById('linkTitle').textContent = '新增友链';
}
</script>

<%- include('partials/foot') %>
