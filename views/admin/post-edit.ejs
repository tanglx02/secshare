<%- include('partials/head') %>

<form method="post" action="/admin/posts/save">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <input type="hidden" name="id" value="<%= isNew ? '' : post.id %>">

  <div style="display:grid;grid-template-columns:minmax(0,1fr) 330px;gap:18px;align-items:start;">
    <div>
      <div class="card">
        <div class="card-head"><h3>基础信息</h3></div>
        <div class="card-body">
          <div class="form-group">
            <label>标题 <span style="color:var(--danger);">*</span></label>
            <input class="form-control" type="text" name="title" value="<%= post.title || '' %>" placeholder="例：Nmap 7.95 官方中文帮助手册 + 图形界面" required>
          </div>
          <div class="form-row-3">
            <div class="form-group">
              <label>URL 别名（slug）</label>
              <input class="form-control" type="text" name="slug" value="<%= post.slug || '' %>" placeholder="留空自动生成">
              <div class="hint">用于 /resource/别名 访问，建议英文</div>
            </div>
            <div class="form-group">
              <label>内容类型</label>
              <select class="form-control" name="type">
                <option value="software" <%= post.type === 'software' ? 'selected' : '' %>>软件工具</option>
                <option value="doc" <%= post.type === 'doc' ? 'selected' : '' %>>学习资料</option>
                <option value="news" <%= post.type === 'news' ? 'selected' : '' %>>资讯文章</option>
              </select>
            </div>
            <div class="form-group">
              <label>所属分类</label>
              <select class="form-control" name="categoryId">
                <option value="">— 未分类 —</option>
                <% Object.values(catMap).forEach(function (c) { %>
                  <option value="<%= c.id %>" <%= String(post.categoryId) === String(c.id) ? 'selected' : '' %>><%= c.icon %> <%= c.name %></option>
                <% }); %>
              </select>
            </div>
          </div>
          <div class="form-group">
            <label>资源简介</label>
            <textarea class="form-control" name="summary" style="min-height:70px;" placeholder="一句话说明这个资源是什么、有什么用（用于列表卡片与 SEO 描述）"><%= post.summary || '' %></textarea>
          </div>
          <div class="form-group">
            <label>正文内容（支持 Markdown）</label>
            <textarea class="form-control" name="content" style="min-height:380px;font-family:Consolas,monospace;font-size:13.2px;" placeholder="# 工具简介&#10;&#10;支持 **Markdown** 语法：标题、列表、代码块、表格、引用等"><%= post.content || '' %></textarea>
            <div class="hint">支持 # 标题、**加粗**、- 列表、``` 代码块、| 表格 |、&gt; 引用</div>
          </div>
        </div>
      </div>

      <div class="card">
        <div class="card-head">
          <h3>下载配置</h3>
          <button class="btn btn-outline btn-sm" type="button" onclick="addLine()">＋ 添加线路</button>
        </div>
        <div class="card-body">
          <div id="lineBox">
            <% var lines = (post.downloadLines && post.downloadLines.length) ? post.downloadLines : [{ name: '主线路', url: post.downloadUrl || '', code: post.downloadCode || '' }]; %>
            <% lines.forEach(function (l) { %>
              <div class="form-row-4" style="margin-bottom:8px;">
                <input class="form-control" name="lineName" value="<%= l.name || '' %>" placeholder="线路名称">
                <input class="form-control" name="lineUrl" value="<%= l.url || '' %>" placeholder="下载地址（https://...）">
                <input class="form-control" name="lineCode" value="<%= l.code || '' %>" placeholder="提取码（可空）">
                <button type="button" class="btn btn-outline btn-sm" onclick="this.parentNode.remove()">删除</button>
              </div>
            <% }); %>
          </div>
          <div class="form-row-3" style="margin-top:14px;">
            <div class="form-group">
              <label>解压密码</label>
              <input class="form-control" type="text" name="unzipPassword" value="<%= post.unzipPassword || '' %>" placeholder="如 secshare">
            </div>
            <div class="form-group">
              <label>文件校验值</label>
              <input class="form-control" type="text" name="fileHash" value="<%= post.fileHash || '' %>" placeholder="SHA256 / MD5">
            </div>
            <div class="form-group">
              <label>文件大小</label>
              <input class="form-control" type="text" name="size" value="<%= post.size || '' %>" placeholder="如 86 MB">
            </div>
          </div>
          <div class="alert alert-info" style="margin-bottom:0;">
            💡 下载地址会按权限控制：仅「免费」与「登录可见」资源对游客开放，其余需会员/积分/购买。建议使用自建直链，避免网盘频繁失效。
          </div>
        </div>
      </div>
    </div>

    <div>
      <div class="card">
        <div class="card-head"><h3>发布设置</h3></div>
        <div class="card-body">
          <div class="form-group">
            <label>发布状态</label>
            <select class="form-control" name="status">
              <option value="published" <%= post.status !== 'draft' ? 'selected' : '' %>>立即发布</option>
              <option value="draft" <%= post.status === 'draft' ? 'selected' : '' %>>保存为草稿</option>
            </select>
          </div>
          <div class="form-group">
            <label>下载权限</label>
            <select class="form-control" name="accessLevel">
              <% var lvs = [['free', '免费下载（所有人）'], ['login', '登录可见'], ['points', '积分兑换'], ['vip', 'VIP 专享'], ['paid', '单独付费']]; %>
              <% lvs.forEach(function (l) { %>
                <option value="<%= l[0] %>" <%= (post.accessLevel || 'vip') === l[0] ? 'selected' : '' %>><%= l[1] %></option>
              <% }); %>
            </select>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label>所需积分</label>
              <input class="form-control" type="number" name="pointsPrice" value="<%= post.pointsPrice || 0 %>" min="0">
            </div>
            <div class="form-group">
              <label>售价（元）</label>
              <input class="form-control" type="text" name="price" value="<%= post.price ? (post.price / 100).toFixed(2) : '0' %>">
            </div>
          </div>
          <div class="divider"></div>
          <label class="checkbox"><input type="checkbox" name="top" <%= post.top ? 'checked' : '' %>> 置顶展示</label>
          <label class="checkbox"><input type="checkbox" name="featured" <%= post.featured ? 'checked' : '' %>> 首页推荐</label>
          <label class="checkbox"><input type="checkbox" name="recommended" <%= post.recommended ? 'checked' : '' %>> 加入推荐位</label>
          <div class="divider"></div>
          <button class="btn btn-primary btn-block btn-lg" type="submit">💾 保存内容</button>
          <a class="btn btn-outline btn-block" href="/admin/posts" style="margin-top:9px;">取消返回</a>
        </div>
      </div>

      <div class="card">
        <div class="card-head"><h3>封面与标签</h3></div>
        <div class="card-body">
          <div class="form-group">
            <label>封面图</label>
            <div style="display:flex;gap:12px;align-items:center;">
              <div class="thumb-preview">
                <% if (post.cover) { %><img src="<%= post.cover %>" alt="" id="coverPreview"><% } else { %><span id="coverPreview">📦</span><% } %>
              </div>
              <div style="flex:1;">
                <input class="form-control" type="text" name="cover" id="coverInput" value="<%= post.cover || '' %>" placeholder="/uploads/images/xxx.png">
                <input type="file" accept="image/*" style="margin-top:8px;font-size:12.5px;" onchange="uploadFile(this,'coverInput')">
              </div>
            </div>
            <div class="hint">留空则显示分类图标作为占位</div>
          </div>
          <div class="form-group">
            <label>标签</label>
            <input class="form-control" type="text" name="tags" value="<%= (post.tags || []).join(',') %>" placeholder="开源免费,Windows,命令行">
            <div class="hint">多个标签用英文逗号或空格分隔</div>
          </div>
        </div>
      </div>

      <div class="card">
        <div class="card-head"><h3>资源属性</h3></div>
        <div class="card-body">
          <div class="form-row">
            <div class="form-group">
              <label>版本号</label>
              <input class="form-control" type="text" name="version" value="<%= post.version || '' %>" placeholder="7.95">
            </div>
            <div class="form-group">
              <label>语言</label>
              <input class="form-control" type="text" name="language" value="<%= post.language || '' %>" placeholder="中文">
            </div>
          </div>
          <div class="form-group">
            <label>适用平台</label>
            <input class="form-control" type="text" name="platform" value="<%= post.platform || '' %>" placeholder="Windows / Linux / macOS">
          </div>
          <div class="form-group">
            <label>官方网站</label>
            <input class="form-control" type="text" name="official" value="<%= post.official || '' %>" placeholder="https://example.com">
          </div>
          <div class="form-group">
            <label>作者 / 来源</label>
            <input class="form-control" type="text" name="author" value="<%= post.author || '站长' %>">
          </div>
        </div>
      </div>
    </div>
  </div>
</form>

<%- include('partials/foot') %>
