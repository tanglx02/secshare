    </div>
  </div>
</div>
<script>
/* 通用后台脚本 */
(function () {
  function csrf() {
    var m = document.cookie.match(/(?:^|;\s*)csrf=([^;]+)/);
    return m ? decodeURIComponent(m[1]) : '';
  }
  window.adminCsrf = csrf;

  // 确认删除
  document.addEventListener('submit', function (e) {
    var form = e.target;
    if (form.getAttribute('data-confirm') && !confirm(form.getAttribute('data-confirm'))) {
      e.preventDefault();
    }
  });

  // 图片上传
  window.uploadFile = function (input, targetId, cb) {
    var file = input.files && input.files[0];
    if (!file) return;
    var fd = new FormData();
    fd.append('file', file);
    var xhr = new XMLHttpRequest();
    xhr.open('POST', '/admin/upload');
    xhr.setRequestHeader('x-csrf-token', csrf());
    xhr.onload = function () {
      try {
        var res = JSON.parse(xhr.responseText);
        if (!res.ok) { alert(res.error || '上传失败'); return; }
        if (targetId) { var el = document.getElementById(targetId); if (el) el.value = res.url; }
        if (cb) cb(res);
        alert('上传成功：' + res.url);
      } catch (err) { alert('上传失败：' + err.message); }
    };
    xhr.send(fd);
  };

  // 全选
  window.toggleAll = function (master) {
    document.querySelectorAll('input[name="ids"]').forEach(function (c) { c.checked = master.checked; });
  };

  // 下载线路动态增删
  window.addLine = function () {
    var box = document.getElementById('lineBox');
    if (!box) return;
    var div = document.createElement('div');
    div.className = 'form-row-4';
    div.style.marginBottom = '8px';
    div.innerHTML = '<input class="form-control" name="lineName" placeholder="线路名称">' +
      '<input class="form-control" name="lineUrl" placeholder="下载地址（https://...）">' +
      '<input class="form-control" name="lineCode" placeholder="提取码（可空）">' +
      '<button type="button" class="btn btn-outline btn-sm" onclick="this.parentNode.remove()">删除</button>';
    box.appendChild(div);
  };

  // 侧边栏分组折叠（状态存 localStorage，当前页所在分组始终展开）
  (function () {
    var KEY = 'adminNavCollapsed';
    var collapsed = {};
    try { collapsed = JSON.parse(localStorage.getItem(KEY) || '{}') || {}; } catch (e) { collapsed = {}; }
    var nav = document.getElementById('adminNav');
    if (!nav) return;

    function apply() {
      nav.querySelectorAll('.nav-group').forEach(function (g) {
        var items = g.querySelector('.group-items');
        var name = g.getAttribute('data-group');
        var hasActive = !!g.querySelector('a.active');
        var isCollapsed = !hasActive && !!collapsed[name];
        g.classList.toggle('collapsed', isCollapsed);
        items.style.maxHeight = isCollapsed ? '0px' : items.scrollHeight + 'px';
        var btn = g.querySelector('.group-toggle');
        if (btn) btn.setAttribute('aria-expanded', String(!isCollapsed));
      });
    }

    nav.querySelectorAll('.group-toggle').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var g = btn.closest('.nav-group');
        var name = g.getAttribute('data-group');
        var willCollapse = !g.classList.contains('collapsed');
        collapsed[name] = willCollapse;
        try { localStorage.setItem(KEY, JSON.stringify(collapsed)); } catch (e) { /* 忽略 */ }
        apply();
      });
    });

    // 字体/布局就绪后重算高度，避免动画首帧高度偏差
    apply();
    window.addEventListener('load', apply);
  })();
})();
</script>
</body>
</html>
