
<% if (query.msg) { %><div class="alert alert-success"><%= query.msg %></div><% } %>
<% if (query.err) { %><div class="alert alert-error"><%= query.err %></div><% } %>

<div class="stat-cards">
  <div class="stat-card <%= cfg.enabled ? 'c1' : '' %>">
    <div class="lbl">邮件服务</div>
    <div class="val" style="font-size:20px;"><%= cfg.enabled ? '已启用' : '未启用' %></div>
  </div>
  <div class="stat-card">
    <div class="lbl">SMTP 服务器</div>
    <div class="val" style="font-size:16px;"><%= cfg.host || '未配置' %></div>
  </div>
  <div class="stat-card <%= cfg.needVerify ? 'c2' : '' %>">
    <div class="lbl">注册邮箱验证</div>
    <div class="val" style="font-size:20px;"><%= cfg.needVerify ? '已开启' : '已关闭' %></div>
  </div>
  <div class="stat-card <%= cfg.hasPass ? 'c2' : 'c3' %>">
    <div class="lbl">密码状态</div>
    <div class="val" style="font-size:20px;"><%= cfg.keyBroken ? '解密失败' : (cfg.hasPass ? '已加密保存' : '未设置') %></div>
  </div>
</div>

<% if (cfg.keyBroken) { %>
  <div class="alert alert-error">
    <b>邮箱密码解密失败</b>：通常是因为 <code>SESSION_SECRET</code> 环境变量被修改过。请在本页重新填写 SMTP 密码并保存。
  </div>
<% } %>

<% if (cfg.needVerify && !cfg.enabled) { %>
  <div class="alert alert-warn">
    <b>已开启注册邮箱验证，但邮件服务未启用</b>：此时验证码不会发到邮箱，而是输出到服务端日志，
    管理员可在本页下方「最近验证码」中查看。<%= s.mailEchoCode === true ? '（调试回显已开启，验证码会直接显示给注册用户）' : '建议尽快配置 SMTP，或临时告知用户到日志/本页获取验证码。' %>
  </div>
<% } %>

<div style="display:grid;grid-template-columns:minmax(0,1fr) 360px;gap:18px;align-items:start;">
  <div class="card">
    <div class="card-head"><h3>SMTP 邮件服务配置</h3></div>
    <div class="card-body">
      <form method="post" action="/admin/mail">
        <input type="hidden" name="_csrf" value="<%= csrf %>">

        <label class="checkbox" style="margin-bottom:16px;">
          <input type="checkbox" name="mailEnabled" <%= cfg.enabled ? 'checked' : '' %>> 启用邮件服务（发送注册验证码等）
        </label>

        <div class="form-row-3">
          <div class="form-group">
            <label>SMTP 服务器</label>
            <input class="form-control" type="text" name="smtpHost" value="<%= s.smtpHost || '' %>" placeholder="smtp.qq.com">
          </div>
          <div class="form-group">
            <label>端口</label>
            <input class="form-control" type="number" name="smtpPort" value="<%= s.smtpPort || 465 %>" placeholder="465">
            <div class="hint">465 用 SSL，587 用 STARTTLS</div>
          </div>
          <div class="form-group">
            <label>加密方式</label>
            <select class="form-control" name="smtpSecure">
              <option value="on" <%= s.smtpSecure !== false ? 'selected' : '' %>>SSL（端口 465）</option>
              <option value="off" <%= s.smtpSecure === false ? 'selected' : '' %>>STARTTLS（端口 587）</option>
            </select>
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label>SMTP 账号</label>
            <input class="form-control" type="text" name="smtpUser" value="<%= s.smtpUser || '' %>" placeholder="通常是完整邮箱地址">
          </div>
          <div class="form-group">
            <label>SMTP 密码 / 授权码</label>
            <input class="form-control" type="password" name="smtpPass" autocomplete="new-password"
                   placeholder="<%= cfg.hasPass ? '已加密保存，留空表示不修改' : '填写邮箱授权码（不是登录密码）' %>">
            <div class="hint">AES-256-GCM 加密存储，页面不回显</div>
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label>发件人名称</label>
            <input class="form-control" type="text" name="smtpFromName" value="<%= s.smtpFromName || '' %>" placeholder="<%= s.siteName %>">
          </div>
          <div class="form-group">
            <label>发件人邮箱</label>
            <input class="form-control" type="text" name="smtpFromEmail" value="<%= s.smtpFromEmail || '' %>" placeholder="留空则使用 SMTP 账号">
          </div>
        </div>

        <div class="divider"></div>

        <label class="checkbox" style="margin-bottom:10px;">
          <input type="checkbox" name="registerNeedEmailVerify" <%= s.registerNeedEmailVerify === true ? 'checked' : '' %>> 注册必须通过邮箱验证码验证
        </label>
        <label class="checkbox" style="margin-bottom:16px;">
          <input type="checkbox" name="mailEchoCode" <%= s.mailEchoCode === true ? 'checked' : '' %>> 调试模式：未配置 SMTP 时把验证码直接显示给用户
        </label>

        <div class="form-group" style="max-width:320px;">
          <label>同一 IP 24 小时注册上限</label>
          <input class="form-control" type="number" name="registerIpDailyLimit" min="0" value="<%= s.registerIpDailyLimit === undefined ? 3 : s.registerIpDailyLimit %>">
          <div class="hint">填 0 表示不限制；与邮箱验证配合可有效挡住批量注册</div>
        </div>
        <div class="alert alert-warn" style="margin-top:0;">
          ⚠️ 「调试模式」仅供本地/内网调试使用。生产环境开启后，任何人无需收邮件即可完成验证，等于关闭了邮箱验证，务必不要开启。
        </div>

        <div style="display:flex;gap:10px;flex-wrap:wrap;">
          <button class="btn btn-primary" type="submit">保存配置</button>
          <button class="btn btn-outline" type="submit" formaction="/admin/mail/test">测试连接</button>
          <button class="btn btn-danger" type="submit" name="clearPass" value="1" formnovalidate
            onclick="return confirm('确定清空已保存的 SMTP 密码吗？');">清空密码</button>
        </div>
      </form>

      <div class="divider"></div>

      <h4 style="font-size:14px;margin-bottom:10px;">发送测试邮件</h4>
      <form method="post" action="/admin/mail/test">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <div style="display:flex;gap:10px;">
          <input class="form-control" type="email" name="testTo" placeholder="收件邮箱，例如 you@example.com">
          <button class="btn btn-outline" type="submit" style="white-space:nowrap;">发送测试邮件</button>
        </div>
      </form>
    </div>
  </div>

  <div>
    <div class="card">
      <div class="card-head"><h3>常见邮箱配置</h3></div>
      <div class="card-body">
        <table class="data" style="font-size:12.5px;">
          <thead><tr><th>邮箱</th><th>服务器</th><th>端口</th></tr></thead>
          <tbody>
            <tr><td>QQ 邮箱</td><td class="mono">smtp.qq.com</td><td>465</td></tr>
            <tr><td>腾讯企业邮</td><td class="mono">smtp.exmail.qq.com</td><td>465</td></tr>
            <tr><td>163 邮箱</td><td class="mono">smtp.163.com</td><td>465</td></tr>
            <tr><td>阿里云邮箱</td><td class="mono">smtp.qiye.aliyun.com</td><td>465</td></tr>
            <tr><td>Gmail</td><td class="mono">smtp.gmail.com</td><td>465</td></tr>
            <tr><td>Outlook</td><td class="mono">smtp.office365.com</td><td>587</td></tr>
          </tbody>
        </table>
        <div class="alert alert-info" style="margin-top:14px;margin-bottom:0;">
          <b>密码怎么填？</b><br>
          QQ 邮箱 / 163 邮箱等都需要填「<b>授权码</b>」而不是登录密码。以 QQ 邮箱为例：
          设置 → 账户 → 开启「IMAP/SMTP 服务」→ 生成授权码，把 16 位授权码填到上面的密码框。
        </div>
      </div>
    </div>

    <div class="card">
      <div class="card-head"><h3>最近验证码</h3><span class="muted small">管理员可查</span></div>
      <div class="table-wrap">
        <table class="data">
          <thead><tr><th>邮箱</th><th>验证码</th><th>状态</th><th>时间</th></tr></thead>
          <tbody>
            <% if (!codes.length) { %><tr><td colspan="4" class="empty">暂无记录</td></tr><% } %>
            <% codes.forEach(function (c) {
                 var expired = new Date(c.expiresAt).getTime() < Date.now();
                 var st = c.used ? ['已使用', 'b-green'] : (expired ? ['已过期', 'b-gray'] : ['有效', 'b-blue']);
            %>
              <tr>
                <td class="small" style="max-width:150px;overflow:hidden;text-overflow:ellipsis;"><%= c.email %></td>
                <td class="mono"><b><%= c.code %></b></td>
                <td><span class="badge <%= st[1] %>"><%= st[0] %></span></td>
                <td class="muted small"><%= formatDate(c.createdAt, true) %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

