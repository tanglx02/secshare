<%
  /* ---------- SEO 计算 ---------- */
  var siteBase = String(settings.siteUrl || '').replace(/\/+$/, '');
  var curPath = (typeof fullPath !== 'undefined' && fullPath) ? fullPath : (typeof path !== 'undefined' ? path : '/');
  var metaDesc = (typeof desc !== 'undefined' && desc) ? desc : settings.siteDescription;
  var metaKeywords = (typeof keywords !== 'undefined' && keywords) ? keywords : settings.siteKeywords;
  var canonicalUrl = (typeof canonical !== 'undefined' && canonical) ? canonical : (siteBase ? siteBase + curPath : '');
  var ogTypeVal = (typeof ogType !== 'undefined' && ogType) ? ogType : 'website';
  var robotsMeta = (typeof robots !== 'undefined' && robots) ? robots : '';
  var ogImg = (typeof ogImage !== 'undefined' && ogImage) ? ogImage : (settings.ogImage || '');
  if (ogImg && !/^https?:\/\//i.test(ogImg) && siteBase) ogImg = siteBase + ogImg;
  var pageTitleVal = (typeof pageTitle !== 'undefined' && pageTitle) ? pageTitle : settings.siteName;
%>
<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= typeof title !== 'undefined' ? title : settings.siteName %></title>
<meta name="description" content="<%= metaDesc %>">
<meta name="keywords" content="<%= metaKeywords %>">
<meta name="renderer" content="webkit">
<% if (robotsMeta) { %><meta name="robots" content="<%= robotsMeta %>"><% } %>
<% if (settings.verifyGoogle) { %><meta name="google-site-verification" content="<%= settings.verifyGoogle %>"><% } %>
<% if (settings.verifyBing) { %><meta name="msvalidate.01" content="<%= settings.verifyBing %>"><% } %>
<% if (settings.verifyBaidu) { %><meta name="baidu-site-verification" content="<%= settings.verifyBaidu %>"><% } %>
<% if (settings.verify360) { %><meta name="360-site-verification" content="<%= settings.verify360 %>"><% } %>
<% if (settings.verifySogou) { %><meta name="sogou_site_verification" content="<%= settings.verifySogou %>"><% } %>
<% if (canonicalUrl) { %><link rel="canonical" href="<%= canonicalUrl %>"><% } %>

<meta property="og:site_name" content="<%= settings.siteName %>">
<meta property="og:title" content="<%= pageTitleVal %>">
<meta property="og:description" content="<%= metaDesc %>">
<meta property="og:type" content="<%= ogTypeVal %>">
<% if (canonicalUrl) { %><meta property="og:url" content="<%= canonicalUrl %>"><% } %>
<% if (ogImg) { %><meta property="og:image" content="<%= ogImg %>"><% } %>
<meta property="og:locale" content="zh_CN">

<meta name="twitter:card" content="<%= ogImg ? 'summary_large_image' : 'summary' %>">
<meta name="twitter:title" content="<%= pageTitleVal %>">
<meta name="twitter:description" content="<%= metaDesc %>">
<% if (ogImg) { %><meta name="twitter:image" content="<%= ogImg %>"><% } %>

<% if (ogTypeVal === 'article') { %>
<meta property="article:published_time" content="<%= typeof publishedTime !== 'undefined' && publishedTime ? publishedTime : '' %>">
<meta property="article:modified_time" content="<%= typeof modifiedTime !== 'undefined' && modifiedTime ? modifiedTime : '' %>">
<meta property="article:section" content="<%= typeof category !== 'undefined' && category ? category.name : '' %>">
<% } %>

<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="alternate" type="application/rss+xml" title="<%= settings.siteName %> RSS" href="/rss.xml">
<link rel="stylesheet" href="/css/main.css">
<script defer src="/js/main.js"></script>
<% if (settings.statsCode) { %><%- settings.statsCode %><% } %>
</head>
<body>
<div class="topbar">
  <div class="container">
    <div class="topbar-left">
      <span>🔒 <%= settings.siteSubtitle || '专注网络安全资源分享' %></span>
      <a href="/disclaimer">免责声明</a>
      <a href="/contact">联系站长</a>
    </div>
    <div class="topbar-right">
      <a href="/resources">全部资源</a>
      <a href="/vip">开通会员</a>
      <a href="/rss.xml" target="_blank">RSS</a>
    </div>
  </div>
</div>

<header class="header">
  <div class="container">
    <a class="logo" href="/">
      <% if (settings.logoImage) { %>
        <img src="<%= settings.logoImage %>" alt="<%= settings.siteName %>">
      <% } else { %>
        <span class="logo-mark">🛡</span>
        <span><%= settings.logoText || settings.siteName %></span>
      <% } %>
    </a>

    <nav class="nav" id="mainNav">
      <a href="/" class="<%= path === '/' ? 'active' : '' %>">首页</a>
      <a href="/resources?type=software" class="<%= query.type === 'software' ? 'active' : '' %>">软件工具</a>
      <a href="/resources?type=doc" class="<%= query.type === 'doc' ? 'active' : '' %>">学习资料</a>
      <a href="/resources" class="<%= path === '/resources' && !query.type ? 'active' : '' %>">全部资源</a>
      <a href="/vip" class="<%= path === '/vip' ? 'active' : '' %>">会员中心</a>
    </nav>

    <div class="header-actions">
      <form class="search-box" action="/search" method="get">
        <input type="search" name="q" placeholder="搜索工具 / 资料…" value="<%= typeof keyword !== 'undefined' ? keyword : '' %>" aria-label="搜索">
        <button type="submit" aria-label="提交搜索">🔍</button>
      </form>
      <% if (user) { %>
        <a class="btn btn-outline btn-sm" href="/user">👤 <%= user.nickname || user.username %></a>
        <% if (user.role === 'admin') { %><a class="btn btn-dark btn-sm" href="/admin">后台</a><% } %>
      <% } else { %>
        <a class="btn btn-outline btn-sm" href="/login">登录</a>
        <a class="btn btn-primary btn-sm" href="/register">注册</a>
      <% } %>
      <button class="nav-toggle" id="navToggle" aria-label="菜单">☰</button>
    </div>
  </div>
</header>
