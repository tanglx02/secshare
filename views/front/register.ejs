<%- include('partials/head') %>

<div class="container">
  <div class="auth-wrap">
    <div class="auth-card">
      <h2>创建账号</h2>
      <p class="sub">注册即赠送 <%= setting('pointsPerRegister', 10) %> 积分</p>

      <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

      <form action="/register" method="post">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <div class="form-group">
          <label>用户名 <span class="req">*</span></label>
          <input class="form-control" type="text" name="username" value="<%= form.username || '' %>" placeholder="3-30 位字母、数字或中文" required autofocus>
        </div>
        <div class="form-group">
          <label>邮箱</label>
          <input class="form-control" type="email" name="email" value="<%= form.email || '' %>" placeholder="选填，用于找回密码">
        </div>
        <div class="form-row">
          <div class="form-group">
            <label>密码 <span class="req">*</span></label>
            <input class="form-control" type="password" name="password" placeholder="至少 6 位" required>
          </div>
          <div class="form-group">
            <label>确认密码 <span class="req">*</span></label>
            <input class="form-control" type="password" name="password2" placeholder="再次输入密码" required>
          </div>
        </div>
        <% if (setting('registerNeedInvite') === true) { %>
        <div class="form-group">
          <label>邀请码 <span class="req">*</span></label>
          <input class="form-control" type="text" name="inviteCode" value="<%= form.inviteCode || '' %>" placeholder="请输入邀请码" required>
          <div class="form-text">本站当前为邀请注册制，请向站长索取邀请码</div>
        </div>
        <% } %>
        <button class="btn btn-primary btn-block btn-lg" type="submit">注 册</button>
      </form>

      <div class="foot">已有账号？<a href="/login">直接登录</a></div>
      <div class="foot small" style="margin-top:10px;color:var(--text-3);">
        注册即表示同意本站 <a href="/disclaimer">免责声明</a>，请勿将本站资源用于任何违法用途
      </div>
    </div>
  </div>
</div>

<%- include('partials/foot') %>
