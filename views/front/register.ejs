<%- include('partials/head') %>

<div class="container">
  <div class="auth-wrap">
    <div class="auth-card">
      <h2>创建账号</h2>
      <p class="sub">
        <% if (needEmailVerify) { %>需通过邮箱验证 · 注册即赠送 <%= setting('pointsPerRegister', 10) %> 积分
        <% } else { %>注册即赠送 <%= setting('pointsPerRegister', 10) %> 积分<% } %>
      </p>

      <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
      <% if (needEmailVerify && !mailReady) { %>
        <div class="alert alert-warn">
          <b>站点尚未配置邮件服务</b><br>
          <% if (setting('mailEchoCode') === true) { %>当前为调试模式，点「获取验证码」后验证码会直接显示在下方。
          <% } else { %>请联系站长配置 SMTP 邮件服务，或让站长直接为你开通账号。<%
          } %>
        </div>
      <% } %>

      <form action="/register" method="post" id="regForm">
        <input type="hidden" name="_csrf" value="<%= csrf %>">

        <div class="form-group">
          <label>用户名 <span class="req">*</span></label>
          <input class="form-control" type="text" name="username" value="<%= form.username || '' %>" placeholder="3-30 位字母、数字或中文" required autofocus>
        </div>

        <div class="form-group">
          <label>邮箱 <%= needEmailVerify ? '<span class="req">*</span>' : '' %></label>
          <div style="display:flex;gap:8px;">
            <input class="form-control" type="email" name="email" id="emailInput" value="<%= form.email || '' %>"
                   placeholder="<%= needEmailVerify ? '用于接收验证码' : '选填，用于找回密码' %>" <%= needEmailVerify ? 'required' : '' %>>
            <% if (needEmailVerify) { %>
              <button class="btn btn-outline" type="button" id="sendBtn" style="white-space:nowrap;min-width:118px;">获取验证码</button>
            <% } %>
          </div>
          <div class="form-text" id="mailTip"></div>
        </div>

        <% if (needEmailVerify) { %>
        <div class="form-group">
          <label>邮箱验证码 <span class="req">*</span></label>
          <input class="form-control" type="text" name="emailCode" inputmode="numeric" maxlength="6"
                 placeholder="6 位数字，10 分钟内有效" required autocomplete="one-time-code">
        </div>
        <% } %>

        <div class="form-row">
          <div class="form-group">
            <label>密码 <span class="req">*</span></label>
            <input class="form-control" type="password" name="password" placeholder="至少 6 位" required>
          </div>
          <div class="form-group">
            <label>确认密码 <span class="req">*</span></label>
            <input class="form-control" type="password" name="password2" placeholder="再次输入密码" required>
          </div>
        </div>

        <% if (needInvite) { %>
        <div class="form-group">
          <label>邀请码 <span class="req">*</span></label>
          <input class="form-control" type="text" name="inviteCode" value="<%= form.inviteCode || '' %>" placeholder="请输入邀请码" required>
          <div class="form-text">本站当前为邀请注册制，请向站长索取邀请码</div>
        </div>
        <% } %>

        <button class="btn btn-primary btn-block btn-lg" type="submit">注 册</button>
      </form>

      <div class="foot">已有账号？<a href="/login">直接登录</a></div>
      <div class="foot small" style="margin-top:10px;color:var(--text-3);">
        注册即表示同意本站 <a href="/disclaimer">免责声明</a>，请勿将本站资源用于任何违法用途
      </div>
    </div>
  </div>
</div>

<% if (needEmailVerify) { %>
<script>
(function () {
  var btn = document.getElementById('sendBtn');
  var emailInput = document.getElementById('emailInput');
  var tip = document.getElementById('mailTip');
  var csrf = <%= JSON.stringify(csrf) %>;
  var timer = null;

  function setTip(text, cls) {
    tip.textContent = text || '';
    tip.style.color = cls === 'error' ? 'var(--danger)' : (cls === 'ok' ? 'var(--success)' : '');
  }

  function countdown(sec) {
    btn.disabled = true;
    var left = sec;
    btn.textContent = left + ' 秒后重发';
    clearInterval(timer);
    timer = setInterval(function () {
      left--;
      if (left <= 0) {
        clearInterval(timer);
        btn.disabled = false;
        btn.textContent = '重新获取';
      } else {
        btn.textContent = left + ' 秒后重发';
      }
    }, 1000);
  }

  btn.addEventListener('click', function () {
    var email = (emailInput.value || '').trim();
    if (!email) { setTip('请先填写邮箱', 'error'); emailInput.focus(); return; }
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { setTip('邮箱格式不正确', 'error'); return; }

    btn.disabled = true;
    btn.textContent = '发送中…';
    setTip('');

    fetch('/api/register/send-code', {
      method: 'POST',
      headers: { 'content-type': 'application/json', 'x-csrf-token': csrf },
      credentials: 'same-origin',
      body: JSON.stringify({ email: email })
    })
      .then(function (r) { return r.json(); })
      .then(function (d) {
        if (!d.ok) {
          btn.disabled = false;
          btn.textContent = '获取验证码';
          setTip(d.error || '发送失败', 'error');
          return;
        }
        setTip(d.message + (d.code ? '　验证码：' + d.code : ''), 'ok');
        countdown(60);
      })
      .catch(function (err) {
        btn.disabled = false;
        btn.textContent = '获取验证码';
        setTip('发送失败：' + err.message, 'error');
      });
  });
})();
</script>
<% } %>

<%- include('partials/foot') %>
