<%- include('partials/head') %>

<div class="container">
  <div style="max-width:560px;margin:60px auto;">
    <div class="card">
      <div class="card-body" style="text-align:center;padding:44px 30px;">
        <div style="font-size:52px;margin-bottom:14px;">🔒</div>
        <h2 style="font-size:19px;margin-bottom:10px;">权限不足，无法下载</h2>
        <p class="muted" style="font-size:14px;margin-bottom:6px;">
          《<%= raw.title %>》为
          <b style="color:var(--warn);"><%= { free: '免费资源', login: '登录可见', points: '积分资源', vip: 'VIP 专享', paid: '付费资源' }[access.level] || '受限资源' %></b>
        </p>

        <% if (access.reason === 'login') { %>
          <p class="muted" style="font-size:13.5px;margin-bottom:22px;">请先登录账号，登录后即可获取下载地址</p>
          <a class="btn btn-primary btn-lg" href="/login?redirect=<%= encodeURIComponent(currentUrl) %>">立即登录</a>
          <a class="btn btn-outline btn-lg" href="/register" style="margin-left:10px;">免费注册</a>
        <% } else if (access.reason === 'vip') { %>
          <p class="muted" style="font-size:13.5px;margin-bottom:22px;">开通会员后可无限下载全站 VIP 资源</p>
          <a class="btn btn-primary btn-lg" href="/vip">👑 查看会员特权</a>
        <% } else if (access.reason === 'points') { %>
          <p class="muted" style="font-size:13.5px;margin-bottom:22px;">
            需要 <%= access.need %> 积分，您当前有 <%= access.have %> 积分
          </p>
          <a class="btn btn-primary btn-lg" href="/vip">获取积分</a>
        <% } else { %>
          <p class="muted" style="font-size:13.5px;margin-bottom:22px;">该资源需单独购买，请联系站长</p>
          <a class="btn btn-primary btn-lg" href="/contact">联系站长</a>
        <% } %>

        <div style="margin-top:24px;">
          <a class="muted small" href="<%= postUrl(raw) %>">← 返回资源详情页</a>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('partials/foot') %>
